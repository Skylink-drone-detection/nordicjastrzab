{
  "name": "web-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Drone monitoring web UI built with Vite and served with Bun",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --port 3000",
    "start": "bun --bun vite preview --port 3000"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "@types/bun": "^1.3.10"
  },
  "dependencies": {
    "maplibre-gl": "^3.6.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
